@page
@model Storefront.Pages.CheckoutModel

@{
    ViewData["Title"] = "Checkout";
}

<section class="checkout-section">

    <div class="container">

        <!-- BACK -->

        <div class="checkout-back">

            <a asp-page="/Product" asp-route-id="@Model.ProductId">

                <i class="bi bi-arrow-left"></i>

                Back to Product

            </a>

        </div>


        <!-- HEADER -->

        <div class="checkout-heading">

            <span class="section-label">
                CHECKOUT
            </span>

            <h1 class="section-title">
                Complete Your Order
            </h1>

            <p class="section-subtitle">
                Review your product and enter your information below.
            </p>

        </div>


        <!-- ERROR -->
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="checkout-alert checkout-alert-error">

                <i class="bi bi-exclamation-circle"></i>

                <span>
                    @Model.ErrorMessage
                </span>

            </div>
        }


        <div class="row g-4">

            <!-- =========================
                 CUSTOMER INFORMATION
                 ========================= -->

            <div class="col-lg-7">

                <div class="checkout-card">

                    <div class="checkout-card-heading">

                        <div class="checkout-card-icon">

                            <i class="bi bi-person"></i>

                        </div>

                        <div>

                            <h2>
                                Customer Information
                            </h2>

                            <p>
                                Enter the information needed for your order.
                            </p>

                        </div>

                    </div>


                    <form method="post">

                        <input type="hidden"
                               asp-for="ProductId" />

                        <input type="hidden"
                               asp-for="ProductName" />

                        <input type="hidden"
                               asp-for="Price" />


                        <!-- NAME -->

                        <div class="checkout-form-group">

                            <label asp-for="CustomerName">
                                Full Name
                            </label>

                            <input asp-for="CustomerName"
                                   class="checkout-input"
                                   placeholder="Enter your full name" />

                            <span asp-validation-for="CustomerName"
                                  class="checkout-validation">
                            </span>

                        </div>


                        <!-- EMAIL -->

                        <div class="checkout-form-group">

                            <label asp-for="CustomerEmail">
                                Email Address
                            </label>

                            <input asp-for="CustomerEmail"
                                   type="email"
                                   class="checkout-input"
                                   placeholder="example@email.com" />

                            <span asp-validation-for="CustomerEmail"
                                  class="checkout-validation">
                            </span>

                        </div>


                        <!-- QUANTITY -->

                        <div class="checkout-form-group">

                            <label asp-for="Quantity">
                                Quantity
                            </label>

                            <div class="quantity-control">

                                <button type="button"
                                        class="quantity-button"
                                        id="decreaseQuantity">

                                    <i class="bi bi-dash"></i>

                                </button>

                                <input asp-for="Quantity"
                                       type="number"
                                       min="1"
                                       max="@Model.AvailableQuantity"
                                       class="quantity-input"
                                       id="quantityInput" />

                                <button type="button"
                                        class="quantity-button"
                                        id="increaseQuantity">

                                    <i class="bi bi-plus"></i>

                                </button>

                            </div>

                            <small class="checkout-help">

                                @Model.AvailableQuantity
                                item(s) available

                            </small>

                            <span asp-validation-for="Quantity"
                                  class="checkout-validation">
                            </span>

                        </div>


                        <!-- SUBMIT -->

                        <button type="submit"
                                class="checkout-submit-button">

                            <span>
                                Place Order
                            </span>

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </form>

                </div>

            </div>


            <!-- =========================
                 ORDER SUMMARY
                 ========================= -->

            <div class="col-lg-5">

                <div class="checkout-card order-summary-card">

                    <div class="checkout-card-heading">

                        <div class="checkout-card-icon">

                            <i class="bi bi-bag"></i>

                        </div>

                        <div>

                            <h2>
                                Order Summary
                            </h2>

                            <p>
                                Your selected product.
                            </p>

                        </div>

                    </div>


                    <!-- PRODUCT -->

                    <div class="checkout-product">

                        <div class="checkout-product-icon">

                            <i class="bi bi-box-seam"></i>

                        </div>

                        <div class="checkout-product-information">

                            <h3>
                                @Model.ProductName
                            </h3>

                            <p>
                                @Model.Price.ToString("C")
                                per item
                            </p>

                        </div>

                    </div>


                    <!-- SUMMARY -->

                    <div class="checkout-summary">

                        <div class="checkout-summary-row">

                            <span>
                                Price
                            </span>

                            <strong>
                                @Model.Price.ToString("C")
                            </strong>

                        </div>


                        <div class="checkout-summary-row">

                            <span>
                                Quantity
                            </span>

                            <strong id="summaryQuantity">
                                @Model.Quantity
                            </strong>

                        </div>


                        <div class="checkout-summary-divider">
                        </div>


                        <div class="checkout-summary-total">

                            <span>
                                Total
                            </span>

                            <strong id="summaryTotal">
                                @((Model.Price * Model.Quantity).ToString("C"))
                            </strong>

                        </div>

                    </div>


                    <!-- NOTICE -->

                    <div class="checkout-notice">

                        <i class="bi bi-shield-check"></i>

                        <span>
                            Stock will be checked again when you place the order.
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const quantityInput =
            document.getElementById("quantityInput");

        const decreaseQuantity =
            document.getElementById("decreaseQuantity");

        const increaseQuantity =
            document.getElementById("increaseQuantity");

        const summaryQuantity =
            document.getElementById("summaryQuantity");

        const summaryTotal =
            document.getElementById("summaryTotal");

        const price = @Model.Price;

        const maximumQuantity =
            @Model.AvailableQuantity;


        function updateSummary() {

            let quantity =
                parseInt(quantityInput.value);

            if (isNaN(quantity) || quantity < 1) {

                quantity = 1;

            }

            if (quantity > maximumQuantity) {

                quantity = maximumQuantity;

            }

            quantityInput.value =
                quantity;

            summaryQuantity.textContent =
                quantity;

            const total =
                price * quantity;

            summaryTotal.textContent =
                new Intl.NumberFormat(
                    "en-PH",
                    {
                        style: "currency",
                        currency: "PHP"
                    }
                ).format(total);
        }


        decreaseQuantity.addEventListener(
            "click",
            function () {

                let quantity =
                    parseInt(quantityInput.value);

                if (quantity > 1) {

                    quantity--;

                    quantityInput.value =
                        quantity;

                    updateSummary();
                }

            }
        );


        increaseQuantity.addEventListener(
            "click",
            function () {

                let quantity =
                    parseInt(quantityInput.value);

                if (quantity < maximumQuantity) {

                    quantity++;

                    quantityInput.value =
                        quantity;

                    updateSummary();
                }

            }
        );


        quantityInput.addEventListener(
            "input",
            updateSummary
        );


        updateSummary();

    </script>

}