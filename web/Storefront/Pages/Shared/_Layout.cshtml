<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - OnlineStore</title>


    <!-- =========================
         GOOGLE FONT
         ========================= -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet">


    <!-- =========================
         BOOTSTRAP
         ========================= -->

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- =========================
         CUSTOM CSS
         ========================= -->

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- =========================
         ASP.NET GENERATED CSS
         ========================= -->

    <link rel="stylesheet"
          href="~/Storefront.styles.css"
          asp-append-version="true" />


    <!-- =========================
         BOOTSTRAP ICONS
         ========================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

</head>


<body>


    <!-- =========================
         NAVIGATION
         ========================= -->

    <header>

        <nav class="navbar navbar-expand-lg store-navbar">

            <div class="container">


                <!-- LOGO -->

                <a class="navbar-brand store-logo"
                   asp-page="/Index">

                    OnlineStore

                </a>


                <!-- MOBILE MENU -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- NAVIGATION LINKS -->

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto">


                        <!-- HOME -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Index">

                                <i class="bi bi-house-door me-1"></i>

                                Home

                            </a>

                        </li>


                        <!-- PRODUCTS -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Index"
                               asp-fragment="products">

                                <i class="bi bi-grid me-1"></i>

                                Products

                            </a>

                        </li>


                        <!-- PRIVACY -->

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-page="/Privacy">

                                <i class="bi bi-shield-check me-1"></i>

                                Privacy

                            </a>

                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <!-- =========================
         MAIN CONTENT
         ========================= -->

    <main>

        @RenderBody()

    </main>



    <!-- =========================
         FOOTER
         ========================= -->

    <footer class="store-footer">

        <div class="container">

            <div class="row align-items-center">


                <!-- FOOTER BRAND -->

                <div class="col-md-6 text-center text-md-start">

                    <div class="footer-brand">

                        <i class="bi bi-bag me-2"></i>

                        OnlineStore

                    </div>

                    <p class="footer-text">

                        Simple. Fast. Reliable.

                    </p>

                </div>


                <!-- FOOTER LINKS -->

                <div class="col-md-6 text-center text-md-end">

                    <a asp-page="/Index"
                       class="footer-link">

                        Home

                    </a>

                    <a asp-page="/Privacy"
                       class="footer-link">

                        Privacy

                    </a>

                </div>


            </div>


            <!-- COPYRIGHT -->

            <div class="footer-bottom">

                <p>

                    <i class="bi bi-c-circle me-1"></i>

                    2026 OnlineStore. All rights reserved.

                </p>

            </div>

        </div>

    </footer>



    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>